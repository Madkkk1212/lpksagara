import { createClient } from '@supabase/supabase-js';
import dotenv from 'dotenv';
dotenv.config({ path: '.env.local' });

const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL || '';
const supabaseKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || '';

const supabase = createClient(supabaseUrl, supabaseKey);

async function check() {
  const { error: matErr } = await supabase
    .from('study_materials')
    .select('id, chapter_id, material_type, video_url, audio_url, file_size');
  if (matErr) console.error("matErr", matErr);
  
  const { error: chapErr } = await supabase
    .from('study_chapters')
    .select('id, level_id, title');
  if (chapErr) console.error("chapErr", chapErr);

  const { error: lvlErr } = await supabase
    .from('study_levels')
    .select('id, level_code, name');
  if (lvlErr) console.error("lvlErr", lvlErr);

  const { error: catErr } = await supabase
    .from('material_categories')
    .select('id, name');
  if (catErr) console.error("catErr", catErr);
}

check().catch(console.error);
